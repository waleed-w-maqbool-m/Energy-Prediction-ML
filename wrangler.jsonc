{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pjm-energy-forecast",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // The dashboard is static; the Worker only runs for /api/*.
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
